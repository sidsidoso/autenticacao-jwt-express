# Ambiente: em "production" a API se recusa a iniciar sem JWT_SECRET
NODE_ENV=development
# Porta HTTP da API
PORT=3000
# Arquivo do banco SQLite (criado automaticamente)
DB_PATH=autenticacao.db
# Segredo do HMAC (HS256) com pelo menos 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Validade do access token e do refresh token, em segundos
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
